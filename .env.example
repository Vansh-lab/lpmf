# --- web/ (Auth.js + Prisma) ---

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Prisma datasource. Dev default is SQLite; switch to Postgres in prod by
# changing ONLY this value (the schema's `url = env("DATABASE_URL")` never
# changes) and the `provider` in web/prisma/schema.prisma.
# NOTE: this path is resolved relative to web/prisma/ (where schema.prisma
# lives), so "file:./dev.db" -> web/prisma/dev.db — NOT "file:./prisma/dev.db".
#   dev:  file:./dev.db
#   prod: postgresql://user:password@host:5432/lpmf
DATABASE_URL="file:./dev.db"

# Email OTP delivery — Gmail SMTP via Nodemailer. SMTP_APP_PASSWORD is a
# Gmail "App Password" (https://myaccount.google.com/apppasswords), not
# your normal account password. The transport is pluggable (see
# web/src/lib/mail/) so this can be swapped for Resend later without
# touching the OTP route logic.
SMTP_USER=
SMTP_APP_PASSWORD=

# --- api/ (FastAPI) ---

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
