    "/tod": {
      "get": {
        "tags": [
          "tod"
        ],
        "summary": "Tod",
        "operationId": "tod_tod_get",
        "parameters": [
          {
            "name": "total_daily_kwh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "description": "Illustrative household profile.",
              "default": 10.0,
              "title": "Total Daily Kwh"
            },
            "description": "Illustrative household profile."
          },
          {
            "name": "evening_peak_fraction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "description": "Share of the day's kWh used in the 17:00-22:00 peak.",
              "default": 0.4,
              "title": "Evening Peak Fraction"
            },
            "description": "Share of the day's kWh used in the 17:00-22:00 peak."
          },
          {
            "name": "shift_fraction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "description": "Share of that peak energy shifted to off-peak hours.",
              "default": 0.3,
              "title": "Shift Fraction"
            },
            "description": "Share of that peak energy shifted to off-peak hours."
