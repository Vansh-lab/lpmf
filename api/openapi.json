    "/dsm": {
      "get": {
        "tags": [
          "dsm"
        ],
        "summary": "Dsm",
        "operationId": "dsm_dsm_get",
        "parameters": [
          {
            "name": "deviation_mw",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "description": "Per 15-min block, ±.",
              "default": 60.0,
              "title": "Deviation Mw"
            },
            "description": "Per 15-min block, ±."
          },
          {
            "name": "schedule_limit_mw",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "default": 41.0,
              "title": "Schedule Limit Mw"
            }
          },
          {
            "name": "normal_rate_per_mwh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "default": 5000.0,
              "title": "Normal Rate Per Mwh"
            }
          },
          {
            "name": "excess_multiplier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "default": 1.5,
              "title": "Excess Multiplier"
            }
          },
          {
            "name": "blocks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 96,
              "minimum": 1,
              "description": "Blocks the deviation lasts (4 = 1 hour).",
              "default": 4,
              "title": "Blocks"
            },
            "description": "Blocks the deviation lasts (4 = 1 hour)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DsmResponse"
