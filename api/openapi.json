              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transformer": {
      "get": {
        "tags": [
          "transformer"
        ],
        "summary": "Transformer",
        "operationId": "transformer_transformer_get",
        "parameters": [
          {
            "name": "hotspot_temp_c",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 250,
              "minimum": -50,
              "description": "Winding hot-spot temperature; default = the deck's 40 °C full-load case.",
              "default": 118.0,
              "title": "Hotspot Temp C"
            },
            "description": "Winding hot-spot temperature; default = the deck's 40 °C full-load case."
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 8760,
              "exclusiveMinimum": 0,
              "description": "Hours held.",
              "default": 1.0,
              "title": "Hours"
            },
            "description": "Hours held."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
